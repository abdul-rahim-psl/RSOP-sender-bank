# Copy to .env (git-ignored) and fill in. Read by server/config.mjs for the bill inquiry proxy.
API_BASE=http://192.168.9.15:9991
SENDER_PARTICIPANT_CODE=
RECEIVER_PARTICIPANT_CODE=
