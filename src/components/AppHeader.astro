---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="app-header">
  <Brand />

  <div class="tools">
    <button class="btn tool" type="button" aria-label="Clear all" data-clear-all>
      <Icon name="retry" size={16} />
      <span class="tool-word">Clear all</span>
    </button>
    <ThemeToggle />
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 22px;
    height: var(--header-h);
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--stroke);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .tool {
    min-height: 36px;
    padding: 6px 14px;
  }

  /* On phones the buttons keep their icons and accessible names. */
  @media (max-width: 640px) {
    .tool {
      width: 36px;
      padding: 0;
    }

    .tool-word {
      display: none;
    }
  }
</style>
