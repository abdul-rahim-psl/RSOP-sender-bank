---
import Light from '../Light.astro';

const rows = [
  { key: 'event-flow', label: 'Event flow', hint: 'Block-list check' },
  { key: 'typology-processor', label: 'Typology processor', hint: 'Interdiction' },
  { key: 'adjudicator', label: 'Event adjudicator', hint: 'Alert decision' },
];
---

<section class="mon glass alerts" aria-labelledby="h-alerts">
  <header class="panel-head">
    <h2 id="h-alerts">Alerts</h2>
  </header>
  <ul class="al-list">
    {
      rows.map((r) => (
        <li class="al-row" data-al={r.key}>
          <p class="al-label">
            {r.label}
            <span>{r.hint}</span>
          </p>
          <div class="al-body">
            <Light size="md" />
            <p class="al-text" data-al-text>
              Not run
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
