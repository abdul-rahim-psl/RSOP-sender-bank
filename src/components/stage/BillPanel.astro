---
import Icon from '../Icon.astro';
import Light from '../Light.astro';
---

<section class="bill glass" aria-labelledby="h-bill" data-bill-panel data-state="empty">
  <header class="panel-head">
    <h2 id="h-bill">Bill</h2>
    <span class="iso">creditor</span>
  </header>

  <div class="bill-empty">
    <span class="empty-icon"><Icon name="bill" size={24} /></span>
    <p>No bill yet. Look one up on the phone.</p>
  </div>

  <div class="bill-body">
    <dl class="bill-meta">
      <div><dt>Institution</dt><dd data-bp-inst></dd></div>
      <div><dt>Bill reference</dt><dd class="mono" data-bp-ref></dd></div>
      <div><dt>Bill ID</dt><dd class="mono" data-bp-id></dd></div>
    </dl>

    <p class="w-label">Components</p>
    <ul class="bill-lines" data-bp-lines></ul>

    <p class="bill-total"><span>Total</span><span data-bp-total></span></p>

    <p class="bill-status" aria-live="polite" data-bp-status>
      <Light />
      <span data-bp-status-text></span>
    </p>
  </div>
</section>

{/* One component row, cloned per account in the biller's reply; its light shows whether that account was paid. */}
<template data-bp-line-tpl>
  <li class="bill-line">
    <Light />
    <span class="bill-line-text">
      <span class="bill-line-name"></span>
      <span class="bill-line-acct mono"></span>
    </span>
    <span class="bill-line-amt"></span>
    <span class="sr-only bill-line-word"></span>
  </li>
</template>
