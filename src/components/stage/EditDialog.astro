---
import Icon from '../Icon.astro';
import { CURRENCY, providers } from '../../data/parties';
---

<dialog class="dlg glass" aria-labelledby="dlg-h" data-dialog>
  <form method="dialog" class="dlg-form" data-dialog-form>
    <h2 id="dlg-h" data-dialog-title>Edit sender</h2>
    <label class="field">
      <span>Name</span>
      <input class="input" type="text" required maxlength="40" autocomplete="off" data-f="name" />
    </label>
    <label class="field">
      <span>Phone</span>
      <input class="input" type="tel" required maxlength="20" autocomplete="off" data-f="phone" />
    </label>
    <label class="field">
      <span>Wallet provider</span>
      <select class="input" data-f="provider">
        {providers.map((p) => <option>{p}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Balance ({CURRENCY})</span>
      <input class="input" type="number" required min="0" max="10000000" step="0.01" data-f="balance" />
    </label>
    <label class="check">
      <input type="checkbox" data-f="blocked" />
      <span>
        <b>On the block list</b>
        <span class="muted">The event flow check stops every payment from this sender.</span>
      </span>
    </label>
    <p class="dlg-note">
      <Icon name="info" size={16} />
      <span>Changes last until Clear all. Nothing is saved.</span>
    </p>
    <div class="dlg-actions">
      <button class="btn" type="button" data-dialog-close>Cancel</button>
      <button class="btn primary" type="submit">Save</button>
    </div>
  </form>
</dialog>
