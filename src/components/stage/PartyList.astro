---
import Icon from '../Icon.astro';
import Light from '../Light.astro';
import { initials, recipients, senders, type Party, type Sender } from '../../data/parties';

interface Props {
  kind: 'sender' | 'recipient';
}

const { kind } = Astro.props;
const isSender = kind === 'sender';
const list: (Party | Sender)[] = isSender ? senders : recipients;
const blocked = (p: Party | Sender) => 'blocked' in p && p.blocked;
---

<section class:list={['parties glass', kind]} aria-labelledby={`h-${kind}`} data-parties={kind}>
  <header class="panel-head">
    <h2 id={`h-${kind}`}>{isSender ? 'Senders' : 'Recipients'}</h2>
    <span class="iso">{isSender ? 'debtor' : 'creditor'}</span>
  </header>
  <ul class="party-list">
    {
      list.map((p) => (
        <li class="party" data-party={p.id} style={`--pc: var(--c-${p.color})`}>
          <button class="party-pick" type="button" aria-pressed="false" data-pick={p.id}>
            <span class="avatar" aria-hidden="true" data-p-initials>
              {initials(p.name)}
            </span>
            <span class="party-text">
              <span class="party-name" data-p-name>
                {p.name}
              </span>
              <span class="party-meta" data-p-phone>
                {p.phone}
              </span>
              <span class="party-prov" data-p-provider>
                {p.provider}
              </span>
              {isSender && (
                <span class="party-flag" data-p-flag hidden={!blocked(p)}>
                  <Icon name="lock" size={12} />
                  Block list
                </span>
              )}
              {!isSender && (
                <span class="receipt" data-receipt hidden>
                  <Light />
                  <span data-receipt-text />
                </span>
              )}
            </span>
          </button>
          {isSender && (
            <button class="party-edit" type="button" aria-label={`Edit ${p.name}`} data-edit={p.id}>
              <Icon name="edit" size={17} />
            </button>
          )}
        </li>
      ))
    }
  </ul>
</section>
