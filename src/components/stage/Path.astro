---
import Icon from '../Icon.astro';

/** Nine dots as on the reference screen; the middle one is the screening gate. */
const DOTS = 9;
const GATE = Math.floor(DOTS / 2);
---

<div class="path" data-path data-gate={GATE}>
  <ol class="dots" aria-hidden="true">
    {
      Array.from({ length: DOTS }, (_, i) => (
        <li class:list={['dot', { gate: i === GATE }]} data-dot={i}>
          {i === GATE && <Icon name="shield" size={15} />}
        </li>
      ))
    }
  </ol>
  <div class="path-labels" aria-hidden="true">
    <span>Sent</span>
    <span>Screening</span>
    <span>Delivered</span>
  </div>
  <p class="path-caption" aria-live="polite" data-path-caption>Waiting for a payment</p>
</div>
