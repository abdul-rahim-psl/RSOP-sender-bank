---
import Icon from '../Icon.astro';

/** Nine dots as on the reference screen; the middle one is the screening gate. */
const DOTS = 9;
const GATE = Math.floor(DOTS / 2);
---

<div class="path" aria-hidden="true" data-path data-gate={GATE}>
  <ol class="dots">
    {
      Array.from({ length: DOTS }, (_, i) => (
        <li class:list={['dot', { gate: i === GATE }]} data-dot={i}>
          {i === GATE && <Icon name="shield" size={13} />}
        </li>
      ))
    }
  </ol>
  <div class="path-labels">
    <span>Sent</span>
    <span>Screening</span>
    <span>Delivered</span>
  </div>
</div>
