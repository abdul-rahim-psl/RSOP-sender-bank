---
import Icon from '../Icon.astro';
import Light from '../Light.astro';
import { account, initials } from '../../data/account';
import { SAMPLE_INSTITUTION, sampleBills } from '../../data/bills';
---

<div class="phone-wrap">
  <div class="phone" role="group" aria-label="Sender's phone">
    <span class="hw hw-vol-up" aria-hidden="true"></span>
    <span class="hw hw-vol-down" aria-hidden="true"></span>
    <span class="hw hw-power" aria-hidden="true"></span>

    <div class="screen" data-screen="form" style={`--pc: var(--c-${account.color})`}>
      <div class="sbar" aria-hidden="true">
        <span class="sbar-time" data-clock>09:41</span>
        <span class="island"></span>
        <svg class="sbar-icons" viewBox="0 0 40 12">
          <path d="M1 10h2.2V8H1zM5 10h2.2V6H5zM9 10h2.2V4H9zM13 10h2.2V2H13z" fill="currentColor" />
          <rect x="21.5" y="1.5" width="15" height="9" rx="2.4" fill="none" stroke="currentColor" stroke-opacity=".5" />
          <rect x="23" y="3" width="10" height="6" rx="1.2" fill="currentColor" />
          <path d="M38.2 4.6v2.8" stroke="currentColor" stroke-opacity=".5" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </div>

      <form class="scr scr-form" data-scr="form" data-inquiry-form novalidate>
        <div class="w-head">
          <span class="avatar" aria-hidden="true">{initials(account.name)}</span>
          <div>
            <p class="w-hi">Hi, {account.name.split(' ')[0]}</p>
            <p class="w-prov">{account.provider}</p>
          </div>
        </div>

        <div class="w-bal">
          <p class="w-bal-label">Balance</p>
          <p class="w-bal-value" data-w-balance></p>
          <p class="w-bal-phone">{account.phone}</p>
        </div>

        <p class="w-title">Pay a bill</p>

        <label class="w-field">
          <span class="w-label">Institution</span>
          <input type="text" autocomplete="off" spellcheck="false" aria-describedby="w-hint" data-institution />
        </label>

        <label class="w-field">
          <span class="w-label">Bill reference</span>
          <input type="text" autocomplete="off" spellcheck="false" aria-describedby="w-hint" data-bill-ref />
        </label>

        <div class="w-quick" role="group" aria-label="Demo bills">
          <span class="w-quick-label" aria-hidden="true">Demo bills</span>
          {
            Object.keys(sampleBills).map((ref) => (
              <button
                class="w-chip"
                type="button"
                aria-pressed="false"
                aria-label={`Demo bill ${ref} at ${SAMPLE_INSTITUTION}`}
                data-sample={ref}
              >
                {ref}
              </button>
            ))
          }
        </div>

        <p class="w-hint" id="w-hint" aria-live="polite" data-w-hint></p>
        <noscript><p class="w-hint">This demo needs JavaScript.</p></noscript>

        <button class="send" type="submit" aria-describedby="w-hint" data-lookup>
          <Icon name="search" size={17} />
          Look up bill
        </button>
      </form>

      <div class="scr scr-busy" data-scr="busy">
        <span class="spinner" aria-hidden="true"></span>
        <p class="s-title" data-s-title></p>
        <p class="s-text" data-s-text></p>
        <p class="s-step" data-s-step></p>
      </div>

      <div class="scr scr-bill" data-scr="bill">
        <button class="w-back" type="button" data-back>
          <Icon name="back" size={16} />
          Change bill
        </button>
        <div class="b-head">
          <p class="w-label">Bill <span class="mono" data-b-id></span></p>
          <p class="b-total" data-b-total></p>
          <p class="b-meta"><span data-b-inst></span> · ref <span class="mono" data-b-ref></span></p>
        </div>
        <ul class="b-lines" aria-label="Bill components" data-b-lines></ul>
        <p class="w-hint" id="b-hint" data-b-hint></p>
        <button class="send" type="button" aria-describedby="b-hint" data-pay>
          <Icon name="send" size={17} />
          <span data-pay-label>Pay</span>
        </button>
      </div>

      <div class="scr scr-done" data-scr="done">
        <Light size="lg" data-d-light />
        <p class="d-title" data-d-title></p>
        <p class="d-text" data-d-text></p>
        <dl class="d-receipt">
          <div><dt>Institution</dt><dd data-d-inst></dd></div>
          <div><dt>Bill reference</dt><dd class="mono" data-d-bill></dd></div>
          <div><dt>Amount</dt><dd data-d-amount></dd></div>
          <div><dt>Reference</dt><dd class="mono" data-d-ref></dd></div>
        </dl>
        <button class="send ghost" type="button" data-new-payment>Pay another bill</button>
      </div>
    </div>
  </div>
</div>

<template data-b-line-tpl>
  <li class="b-line"><span class="b-name"></span><span class="b-amt"></span></li>
</template>
