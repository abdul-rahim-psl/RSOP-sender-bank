---
import Icon from '../Icon.astro';
import Light from '../Light.astro';
import { account, initials } from '../../data/account';
import { BILL_REF_LENGTH, institutions } from '../../data/bills';
---

<div class="phone" role="group" aria-label="Sender's phone">
  <span class="hw hw-vol-up" aria-hidden="true"></span>
  <span class="hw hw-vol-down" aria-hidden="true"></span>
  <span class="hw hw-power" aria-hidden="true"></span>

  <div class="screen" data-screen="login" style={`--pc: var(--c-${account.color})`}>
    <div class="sbar" aria-hidden="true">
      <span class="sbar-time" data-clock>09:41</span>
      <span class="island"></span>
      <svg class="sbar-icons" viewBox="0 0 40 12">
        <path d="M1 10h2.2V8H1zM5 10h2.2V6H5zM9 10h2.2V4H9zM13 10h2.2V2H13z" fill="currentColor" />
        <rect x="21.5" y="1.5" width="15" height="9" rx="2.4" fill="none" stroke="currentColor" stroke-opacity=".5" />
        <rect x="23" y="3" width="10" height="6" rx="1.2" fill="currentColor" />
        <path d="M38.2 4.6v2.8" stroke="currentColor" stroke-opacity=".5" stroke-width="1.4" stroke-linecap="round" />
      </svg>
    </div>

    {/* Every visit starts here; the demo has no real sign-in, so any username and password will do. */}
    <form class="scr scr-login" data-scr="login" data-login-form novalidate>
      <div class="l-brand">
        <span class="avatar" aria-hidden="true">{initials(account.provider)}</span>
        <p class="w-hi">{account.provider}</p>
        <p class="w-prov">Sign in to pay a bill</p>
      </div>

      <label class="w-field">
        <span class="w-label">Username</span>
        <input type="text" autocomplete="username" data-login-user />
      </label>
      <label class="w-field">
        <span class="w-label">Password</span>
        <input type="password" autocomplete="current-password" data-login-pass />
      </label>

      <p class="w-hint" id="l-hint" aria-live="polite" data-l-hint></p>
      <noscript><p class="w-hint">This demo needs JavaScript.</p></noscript>

      <button class="send" type="submit" aria-describedby="l-hint">
        <Icon name="lock" size={17} />
        Sign in
      </button>
    </form>

    <form class="scr scr-form" data-scr="form" data-inquiry-form novalidate>
      <div class="w-head">
        <span class="avatar" aria-hidden="true" data-w-avatar>{initials(account.name)}</span>
        <div class="w-who">
          <p class="w-hi" data-w-hi>Hi, {account.name.split(' ')[0]}</p>
          <p class="w-prov">{account.provider}</p>
        </div>
        <button class="w-out" type="button" data-logout>
          <Icon name="logout" size={15} />
          Log out
        </button>
      </div>

      <div class="w-bal">
        <p class="w-bal-label">Balance</p>
        <p class="w-bal-value" data-w-balance></p>
      </div>

      <p class="w-title">Pay a bill</p>

      <label class="w-field">
        <span class="w-label">Institution</span>
        <span class="w-select">
          <select data-institution>
            {institutions.map((i) => <option value={i}>{i}</option>)}
          </select>
          <Icon name="chevron" size={18} />
        </span>
      </label>

      <label class="w-field">
        <span class="w-label">Bill reference</span>
        <input
          type="text"
          inputmode="text"
          maxlength={BILL_REF_LENGTH}
          pattern={`[A-Za-z0-9]{${BILL_REF_LENGTH}}`}
          placeholder={`${BILL_REF_LENGTH} letters or digits`}
          autocomplete="off"
          spellcheck="false"
          aria-describedby="w-hint"
          data-bill-ref
        />
      </label>

      <p class="w-hint" id="w-hint" aria-live="polite" data-w-hint></p>
      <noscript><p class="w-hint">This demo needs JavaScript.</p></noscript>

      <button class="send" type="submit" aria-describedby="w-hint" data-lookup>
        <Icon name="search" size={17} />
        Look up bill
      </button>
    </form>

    <div class="scr scr-busy" data-scr="busy">
      <span class="spinner" aria-hidden="true"></span>
      <p class="s-title">Looking up</p>
      <p class="s-text" data-s-text></p>
      <p class="s-step">Asking the biller</p>
    </div>

    {/* One bill screen through the whole payment: unpaid, paying, then paid or failed. */}
    <div class="scr scr-bill" data-scr="bill" data-stage="open">
      <div class="b-top">
        <button class="w-back" type="button" aria-label="Change bill" data-back>
          <Icon name="back" size={18} />
        </button>
        <p class="w-title">Bill</p>
        <button class="w-out icon" type="button" aria-label="Log out" data-logout>
          <Icon name="logout" size={15} />
        </button>
      </div>

      <dl class="bill-meta">
        <div><dt>Institution</dt><dd data-b-inst></dd></div>
        <div><dt>Bill reference</dt><dd class="mono" data-b-ref></dd></div>
        <div><dt>Bill ID</dt><dd class="mono" data-b-id></dd></div>
      </dl>

      <p class="w-label">Components</p>
      <ul class="bill-lines" data-b-lines></ul>

      <p class="bill-total"><span>Total</span><span data-b-total></span></p>

      <div class="bill-status" aria-live="polite" data-b-status>
        <Light />
        <span class="bill-status-text">
          <strong data-b-status-title></strong>
          <span data-b-status-sub></span>
        </span>
      </div>

      <p class="w-hint" id="b-hint" data-b-hint></p>

      <button class="send b-pay" type="button" aria-describedby="b-hint" data-pay>
        <Icon name="send" size={17} />
        <span data-pay-label>Pay</span>
      </button>
      <button class="send ghost b-again" type="button" data-new-payment>Pay another bill</button>
    </div>

    {/* The outcome of a lookup or a payment, over whichever screen asked; demo.ts fills and opens it. */}
    <div class="outcome" data-pop hidden>
      <div class="outcome-card" role="alertdialog" aria-modal="true" aria-labelledby="pop-title" aria-describedby="pop-text" data-pop-card>
        <span class="outcome-badge" aria-hidden="true">
          <span class="outcome-icon" data-for="ok"><Icon name="check" size={30} /></span>
          <span class="outcome-icon" data-for="fail"><Icon name="x" size={28} /></span>
        </span>
        <p class="outcome-kicker" data-pop-kicker></p>
        <p class="outcome-title" id="pop-title" data-pop-title></p>
        <p class="outcome-amount" data-pop-amount></p>
        <p class="outcome-text" id="pop-text" data-pop-text></p>

        {/* A payment's receipt: the amount on a watermarked panel, when, from whom to which biller, and the STAN. */}
        <div class="receipt" data-receipt hidden>
          <div class="receipt-amount">
            <span class="receipt-wm" aria-hidden="true">{Array.from({ length: 60 }, () => account.provider).join('   ')}</span>
            <span class="receipt-sum" data-r-amount></span>
          </div>
          <p class="receipt-when" data-r-when></p>
          <hr class="receipt-rule" />
          <ul class="receipt-parties">
            <li>
              <span class="party-badge" data-party="bank" aria-hidden="true">{initials(account.provider)}</span>
              <span class="party-text">
                <span class="party-label">From Account</span>
                <span class="party-name" data-r-from-name></span>
                <span class="party-sub mono" data-r-from-sub></span>
              </span>
            </li>
            <li>
              <span class="party-badge" data-party="biller" aria-hidden="true" data-r-to-badge></span>
              <span class="party-text">
                <span class="party-label">To Biller</span>
                <span class="party-name" data-r-to-name></span>
                <span class="party-sub mono" data-r-to-sub></span>
              </span>
            </li>
          </ul>
          <hr class="receipt-rule" />
          <p class="receipt-ref">Reference Number (STAN): <span class="mono" data-r-ref></span></p>
        </div>

        <dl class="outcome-facts" data-pop-facts></dl>
        <div class="outcome-actions">
          <button class="send" type="button" data-pop-primary></button>
          <button class="send ghost" type="button" data-pop-secondary></button>
        </div>
      </div>
    </div>
  </div>
</div>

{/* One component row, cloned per account in the biller's reply; its light shows whether that account was paid. */}
<template data-b-line-tpl>
  <li class="bill-line">
    <Light />
    <span class="bill-line-text">
      <span class="bill-line-name"></span>
      <span class="bill-line-acct mono"></span>
    </span>
    <span class="bill-line-amt"></span>
    <span class="sr-only bill-line-word"></span>
  </li>
</template>
