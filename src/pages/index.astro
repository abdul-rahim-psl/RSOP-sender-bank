---
import '../styles/demo.css';
import Base from '../layouts/Base.astro';
import AppHeader from '../components/AppHeader.astro';
import Icon from '../components/Icon.astro';
import Phone from '../components/stage/Phone.astro';
import Path from '../components/stage/Path.astro';
import BillPanel from '../components/stage/BillPanel.astro';
import { ALERT_AMOUNT, RAPID_FROM, STOP_AMOUNT } from '../data/network';
import { SAMPLE_INSTITUTION, sampleBills } from '../data/bills';
import { money } from '../lib/format';

const how = [
  { when: `Under ${money(ALERT_AMOUNT)}`, then: 'No alert' },
  { when: `${money(ALERT_AMOUNT)} to ${money(STOP_AMOUNT - 0.01)}`, then: 'Alert raised; still paid' },
  { when: `${money(STOP_AMOUNT)} or more`, then: 'Stopped by a typology' },
  { when: `The account's payment no. ${RAPID_FROM} or later`, then: 'Counts one level higher' },
];
const bills = Object.entries(sampleBills).map(([ref, r]) => ({ ref, total: money(Number(r.total), r.currency) }));
---

<Base title="Sender-initiated payment">
  <AppHeader />
  <main class="demo" id="main" data-demo>
    <div class="intro">
      <div>
        <h1 class="title">Sender-initiated payment<span class="pd">.</span></h1>
        <p>
          Enter an institution and a bill reference on the phone, look up the bill and pay it. The payment is screened
          before it reaches the biller.
        </p>
      </div>
      <button class="btn" type="button" popovertarget="how">
        <Icon name="info" size={16} />
        How it decides
      </button>
    </div>

    <section class="stage" aria-label="Payment">
      <Phone />
      <Path />
      <BillPanel />
    </section>
  </main>

  <div id="how" class="pop glass" popover>
    <p class="seclabel">Mock screening</p>
    <h2>How it decides</h2>
    <table class="how">
      <tbody>
        {
          how.map((h) => (
            <tr>
              <th scope="row">{h.when}</th>
              <td>{h.then}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="seclabel how-sub">Demo bills at institution {SAMPLE_INSTITUTION}</p>
    <table class="how">
      <tbody>
        {
          bills.map((b) => (
            <tr>
              <th scope="row" class="mono">{b.ref}</th>
              <td>{b.total}</td>
            </tr>
          ))
        }
        <tr>
          <th scope="row">Any other reference</th>
          <td>Bill not found</td>
        </tr>
      </tbody>
    </table>
    <p class="how-note">Invented for the demo; bill 123 matches the API's sample reply. Clear all resets the payment count.</p>
  </div>
</Base>

<script>
  import '../scripts/demo';
</script>
